{
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/planification-livraison",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://home-sweet.be https://www.home-sweet.be https://*.myshopify.com https://*.shopifypreview.com"
        }
      ]
    }
  ]
}
